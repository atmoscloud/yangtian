{% assign extension = include.path | split: '.' | last %}

<figure>
  {% if extension == 'mp4' or extension == 'webm' or extension == 'ogg' %}
    <video
      {% if include.cache_bust %}
        src="{{ include.path | relative_url | bust_file_cache }}"
      {% else %}
        src="{{ include.path | relative_url }}"
      {% endif %}
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      {% if include.width %}
        width="{{ include.width }}"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% endif %}
      {% if include.autoplay %}
        autoplay
      {% endif %}
      {% if include.loop %}
        loop
      {% endif %}
      {% if include.muted %}
        muted
      {% endif %}
      {% if include.playsinline %}
        playsinline
      {% endif %}
      {% if include.controls %}
        controls
      {% endif %}
      preload="metadata"
      style="max-width:{{ include.max-width | default: '100%' }}; border-radius:12px;"
    >
      <source src="{{ include.path | relative_url }}" type="video/{{ extension }}">
      Your browser does not support the video tag.
    </video>

  {% else %}
    <iframe
      src="{{ include.path }}"
      {% if include.class %}
        class="{{ include.class }}"
      {% endif %}
      frameborder="0"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
      {% if include.width %}
        width="{{ include.width }}"
      {% endif %}
      {% if include.height %}
        height="{{ include.height }}"
      {% endif %}
    ></iframe>
  {% endif %}

  {% if include.caption %}
    <figcaption class="caption text-center mt-2">{{ include.caption }}</figcaption>
  {% endif %}
</figure>
